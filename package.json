{
  "name": "homeless-dark",
  "private": true,
  "version": "0.3.0",
  "description": "HOMELESS on the web-native DARK engine (Three.js + Rapier + Web Audio + Capacitor).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w apps/homeless-web",
    "build": "npm run build -w apps/homeless-web && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('apps/homeless-web/dist','dist',{recursive:true})\"",
    "preview": "npm run preview -w apps/homeless-web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node tools/web/build-assets.mjs",
    "data": "python3 tools/web/build_data.py",
    "university": "node tools/web/university-lock.mjs",
    "android:prepare": "bash tools/web/android-prepare.sh",
    "android:build": "bash tools/web/android-build.sh",
    "dev:legacy": "npm run dev -w apps/homeless-legacy",
    "build:legacy": "npm run build -w apps/homeless-legacy",
    "typecheck:legacy": "tsc -p apps/homeless-legacy/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.2.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.181.0",
    "fbx2gltf": "0.9.7-p1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
